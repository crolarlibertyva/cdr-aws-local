FROM mcr.microsoft.com/devcontainers/python:1-3.11-bullseye

# Optionally pin to a specific VS Code server commit.
ARG VSCODE_SERVER_COMMIT=

WORKDIR /tmp/setup

COPY requirements.txt /tmp/setup/requirements.txt

# Install AWS CLI v2 and clean up apt metadata to keep image size down.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl unzip \
    && update-ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
        arch="$(dpkg --print-architecture)"; \
        case "$arch" in \
            amd64) awscli_arch="x86_64" ;; \
            arm64) awscli_arch="aarch64" ;; \
            *) echo "Unsupported architecture for VS Code Server: $arch"; exit 1 ;; \
        esac; \
        curl -fsSL --retry 5 --retry-all-errors "https://awscli.amazonaws.com/awscli-exe-linux-${awscli_arch}.zip" -o "awscliv2.zip"; \
    unzip awscliv2.zip; \
    ./aws/install; \
        rm -rf aws awscliv2.zip

RUN pip install --no-cache-dir -r /tmp/setup/requirements.txt

# Preinstall VS Code Server for Linux to reduce first attach setup time.
RUN set -eux; \
        arch="$(dpkg --print-architecture)"; \
        case "$arch" in \
            amd64) vscode_arch="x64"; update_api_platform="linux-x64" ;; \
            arm64) vscode_arch="arm64"; update_api_platform="linux-arm64" ;; \
            *) echo "Unsupported architecture for VS Code Server: $arch"; exit 1 ;; \
        esac; \
        if [ -n "$VSCODE_SERVER_COMMIT" ]; then \
            resolved_commit="$VSCODE_SERVER_COMMIT"; \
        else \
            resolved_commit="$(curl -fsSL --retry 5 --retry-all-errors "https://update.code.visualstudio.com/api/commits/stable/${update_api_platform}" | tr -d '[]\"[:space:]' | cut -d, -f1)"; \
        fi; \
        if [ -z "$resolved_commit" ]; then \
            echo "Failed to resolve VS Code server commit"; \
            exit 1; \
        fi; \
        vscode_url="https://update.code.visualstudio.com/commit:${resolved_commit}/server-linux-${vscode_arch}/stable"; \
        install_dir="/home/vscode/.vscode-server/bin/${resolved_commit}"; \
        mkdir -p "$install_dir"; \
        if ! curl -kfsSL --retry 5 --retry-all-errors "$vscode_url" -o /tmp/vscode-server.tar.gz; then \
            VSCODE_URL="$vscode_url" python -c "import os, ssl, certifi, urllib.request; url=os.environ['VSCODE_URL']; ctx=ssl.create_default_context(cafile=certifi.where()); data=urllib.request.urlopen(url, context=ctx).read(); open('/tmp/vscode-server.tar.gz', 'wb').write(data)"; \
        fi; \
        tar -xzf /tmp/vscode-server.tar.gz -C "$install_dir" --strip-components=1; \
        rm -f /tmp/vscode-server.tar.gz; \
        chown -R vscode:vscode /home/vscode/.vscode-server
RUN mkdir /workspace && chown -R vscode:vscode /workspace
WORKDIR /workspace
